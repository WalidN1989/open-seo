# Use the full Node image so workerd has a working CA trust store for outbound HTTPS.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Vite inlines these public/build-mode values. Railway exposes service
# variables to Docker builds only when the Dockerfile declares matching ARGs.
# Keep secrets out of this list: runtime secrets are materialized into the
# worker bundle by write-runtime-dev-vars.ts when the container starts.
ARG AUTH_MODE=local_noauth
ARG BYPASS_EMAIL_VERIFICATION
ARG POSTHOG_PUBLIC_KEY
ARG POSTHOG_HOST
ARG POSTHOG_SOURCEMAPS
ARG TURNSTILE_SITE_KEY
ARG VITE_SHOW_DEVTOOLS=false
ARG ALLOWED_HOST
ARG BETTER_AUTH_URL

ENV AUTH_MODE=$AUTH_MODE \
    BYPASS_EMAIL_VERIFICATION=$BYPASS_EMAIL_VERIFICATION \
    POSTHOG_PUBLIC_KEY=$POSTHOG_PUBLIC_KEY \
    POSTHOG_HOST=$POSTHOG_HOST \
    POSTHOG_SOURCEMAPS=$POSTHOG_SOURCEMAPS \
    TURNSTILE_SITE_KEY=$TURNSTILE_SITE_KEY \
    VITE_SHOW_DEVTOOLS=$VITE_SHOW_DEVTOOLS \
    ALLOWED_HOST=$ALLOWED_HOST \
    BETTER_AUTH_URL=$BETTER_AUTH_URL

# Build once in Railway's image builder. Previously this ran after the paid
# production container started, briefly pushing RAM above 20 GB on every
# deployment while the old container remained live for zero-downtime handoff.
RUN pnpm run build

EXPOSE 3001

# Readiness probe against the unauthenticated setup/health endpoint. The build
# is already in the image, so startup only needs preflight and migrations.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

# Startup (preflight, migrations, runtime bindings, serve) lives in
# docker-entrypoint.sh.
CMD ["sh", "docker-entrypoint.sh"]
